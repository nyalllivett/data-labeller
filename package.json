{
  "name": "data-labeller",
  "version": "0.1.0",
  "private": true,
  "main": "index.ts",
  "engines": {
    "node": "24.x",
    "npm": "11.x"
  },
  "packageManager": "npm@11.9.0",
  "scripts": {
    "start": "expo start --dev-client",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "prebuild": "expo prebuild --no-install",
    "test": "jest --runInBand",
    "test:coverage": "jest --runInBand --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "check": "npm run test && npm run typecheck && npm run lint",
    "bundle:check": "expo export --platform ios --platform android --output-dir dist",
    "postinstall": "node -e \"require('./scripts/verify-camera-version.cjs')(require('expo-camera/package.json').version)\" && patch-package --error-on-fail"
  },
  "dependencies": {
    "expo": "~57.0.27",
    "expo-camera": "57.0.6",
    "expo-crypto": "~57.0.3",
    "expo-dev-client": "~57.0.19",
    "expo-file-system": "57.0.7",
    "expo-sqlite": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "expo-video": "~57.0.5",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0"
  },
  "devDependencies": {
    "@testing-library/react-native": "14.1.0",
    "@types/jest": "29.5.14",
    "@types/react": "~19.2.2",
    "eslint": "9.39.5",
    "eslint-config-expo": "~57.0.2",
    "jest": "29.7.0",
    "jest-expo": "~57.0.5",
    "patch-package": "8.0.1",
    "test-renderer": "1.0.0",
    "typescript": "~6.0.3"
  },
  "expo": {
    "autolinking": {
      "buildFromSource": [
        "expo-camera"
      ]
    }
  }
}
